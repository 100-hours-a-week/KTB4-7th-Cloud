{
 "uid": "memme-v2-backend",
 "title": "memme V2 BE 앱",
 "tags": [
  "memme-v2"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": true,
 "graphTooltip": 1,
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "#5794F2",
    "name": "배포",
    "target": {
     "type": "tags",
     "tags": [
      "deploy"
     ],
     "limit": 100,
     "matchAny": false
    }
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "#F2495C",
    "name": "태스크 중지",
    "target": {
     "type": "tags",
     "tags": [
      "task-stop"
     ],
     "limit": 100,
     "matchAny": false
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "API (어느 API가 느리고 실패하는가)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "API별 응답 시간 p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 9
   },
   "description": "SLO 버킷(0.1·0.3·1·3·10초) 기준 추정치. 3초 이상이면 ALB p95 알림과 같은 수준",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"backend\",service=\"web\",uri!~\"/actuator.*|UNKNOWN\"}[5m])))",
     "legendFormat": "{{method}} {{uri}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "title": "API별 오류(5xx) 초당",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 9
   },
   "description": "0이면 표시되지 않음. exception 라벨로 예외 종류 확인",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (method, uri, status, exception) (rate(http_server_requests_seconds_count{job=\"backend\",service=\"web\",uri!~\"/actuator.*|UNKNOWN\",status=~\"5..\"}[5m])) > 0",
     "legendFormat": "{{status}} {{method}} {{uri}} {{exception}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "title": "API별 요청 수 초당 (상위 10)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "description": "폭주한 API 확인",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"backend\",service=\"web\",uri!~\"/actuator.*|UNKNOWN\"}[5m])))",
     "legendFormat": "{{method}} {{uri}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "title": "API별 평균 응답 시간 (상위 10)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"backend\",service=\"web\",uri!~\"/actuator.*|UNKNOWN\"}[5m])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"backend\",service=\"web\",uri!~\"/actuator.*|UNKNOWN\"}[5m])))",
     "legendFormat": "{{method}} {{uri}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "row",
   "title": "DB 연결 풀·스레드 (왜 막혔는가)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 7,
   "title": "DB 연결 풀 (태스크별)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "description": "대기가 0보다 크면 연결 부족. 10/22 장애 때 고갈된 지점",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_active{job=\"backend\",service=\"web\"}",
     "legendFormat": "사용 중 {{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_pending{job=\"backend\",service=\"web\"}",
     "legendFormat": "대기 {{instance}}"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_max{job=\"backend\",service=\"web\"}",
     "legendFormat": "최대 {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "title": "연결 획득 시간·실패",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "description": "시간 초과는 connection-timeout(3초) 초과 건수",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (instance) (rate(hikaricp_connections_acquire_seconds_sum{job=\"backend\",service=\"web\"}[5m]) / rate(hikaricp_connections_acquire_seconds_count{job=\"backend\",service=\"web\"}[5m]))",
     "legendFormat": "평균 획득 {{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase(hikaricp_connections_timeout_total{job=\"backend\",service=\"web\"}[5m])",
     "legendFormat": "5분 시간 초과 {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "title": "Tomcat 요청 스레드 (태스크별)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "description": "최대에 닿으면 /health까지 대기. 10/22 health 실패 원인 후보",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tomcat_threads_busy_threads{job=\"backend\",service=\"web\",name=~\".*8080.*\"}",
     "legendFormat": "사용 중 {{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tomcat_threads_config_max_threads{job=\"backend\",service=\"web\",name=~\".*8080.*\"}",
     "legendFormat": "최대 {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "JVM·프로세스",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 11,
   "title": "CPU 사용률",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "process_cpu_usage{job=\"backend\"}",
     "legendFormat": "{{service}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "title": "힙 메모리 사용",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service, instance) (jvm_memory_used_bytes{job=\"backend\",area=\"heap\"})",
     "legendFormat": "사용 {{service}} {{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service, instance) (jvm_memory_max_bytes{job=\"backend\",area=\"heap\"})",
     "legendFormat": "최대 {{service}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "title": "GC 정지 시간 (초당)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service, instance) (rate(jvm_gc_pause_seconds_sum{job=\"backend\"}[5m]))",
     "legendFormat": "{{service}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "title": "수집 상태",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 5
   },
   "description": "ECS 태스크를 30초마다 찾아 8081/actuator/prometheus를 수집. 1=정상",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"backend\"}",
     "legendFormat": "{{service}} {{instance}} :{{revision}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showValue": "never"
   }
  }
 ],
 "description": "BE 웹 태스크의 API별 지연·오류, DB 연결 풀, Tomcat 스레드, JVM. 파란 표시=배포, 빨간 표시=비정상 태스크 중지"
}