# /opt/monitoring/.env (chmod 600). 값은 저장소에 넣지 않습니다.
GF_ADMIN_PASSWORD=          # 서버에서 무작위 생성 (openssl rand)
TUNNEL_TOKEN=               # SSM /memme/v2/monitoring/cloudflared-token
DISCORD_WEBHOOK_URL=        # SSM /memme/v2/monitoring/discord-webhook
CLOUDFLARED_VERSION=2026.10.2
GRAFANA_ADMIN_EMAIL=        # Grafana Admin으로 들어올 Cloudflare Access 이메일
# mysqld-exporter.cnf는 SSM /memme/v2/monitoring/mysql-monitor-password로 별도 생성 (README 참고)
